# Store these in your hosting provider's environment settings, not the mod.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your-private-jimbob-maps-bucket
B2_KEY_ID=
B2_APPLICATION_KEY=
MAPS_PUBLISH_TOKEN=
MAPS_AUTHOR=Jimbob
# Mount a persistent volume here. Back up the SQLite catalogue alongside B2.
MAPS_DATA_DIR=/data/jimbob-maps
PORT=19799
# Set to 1 only behind your hosting provider's controlled reverse proxy.
MAPS_TRUST_PROXY=0
# Development only: set MAPS_STORAGE=local to test without a B2 account.
